---
import { Image } from "astro:assets";
import IconLight from "@assets/icons/light/icon.png";
---

<footer class="footer">
    <div class="footer-left">
        <div class="footer-info">
            <Image
                src={IconLight}
                alt="Origami Systems Logo"
                title="Origami Systems"
                width="64"
                height="64"
                class="footer-logo"
            />
            <div class="footer-text">
                <strong>Origami Systems</strong><br />
                &copy; 2024-{new Date().getFullYear()} Origami Systems LLC. All rights
                reserved.
            </div>
        </div>
    </div>

    <div class="footer-right">
        <div class="footer-columns">
            <div>
                <h4>Origami Systems</h4>
                <a href="/">Home</a>
                <a href="/about">About</a>
                <a href="/schools">For Schools</a>
                <a href="/blog">Blog</a>
            </div>
            <div>
                <h4>Apps</h4>
                <a href="https://account.origamisystems.org" target="_blank" rel="noopener noreferrer">Account</a>
                <a href="https://the-house-app.com" target="_blank" rel="noopener noreferrer">The House App</a>
                <a href="/signups">The Signups App</a>
                <a href="https://help.origamisystems.org" target="_blank" rel="noopener noreferrer">The Help App</a>
            </div>
            <div>
                <h4>Socials</h4>
                <a
                    href="https://www.instagram.com/origamisystems"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Instagram
                </a>
                <a
                    href="https://www.facebook.com/origamisystemsllc"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Facebook
                </a>
                <a
                    href="https://www.linkedin.com/company/origami-systems"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    LinkedIn
                </a>
                <a
                    href="https://x.com/_origamisystems"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    X
                </a>
            </div>
            <div>
                <h4>Support</h4>
                <!-- <a href="/about">About</a> -->
                <a href="https://status.origamisystems.org" target="_blank">
                    Status
                </a>
                <!-- <a href="/docs">Docs</a> -->
                <a href="/faq">FAQ</a>
                <a href="/terms">Terms</a>
                <a href="/privacy">Privacy</a>
            </div>
        </div>
    </div>
</footer>

<style>
    .footer {
        margin-top: 6.5rem;
        padding: 2rem;
        border-top: var(--divider-thin);
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: -35px;
        transition: var(--transitions);
    }
    .footer .footer-left {
        margin-bottom: 1rem;
    }
    .footer .footer-left .footer-info {
        display: flex;
        align-items: center;
    }
    .footer .footer-left .footer-info .footer-logo {
        border-radius: 0.5rem;
        margin-right: 1rem;
        user-select: none;
    }
    .footer .footer-left .footer-info .footer-text a {
        text-decoration: none;
    }
    .footer .footer-right .footer-columns {
        display: flex;
        flex-direction: row;
        gap: 3rem;
        text-align: left;
    }
    .footer .footer-right .footer-columns h4 {
        white-space: nowrap;
        font-weight: bold;
        font-size: 1rem;
        margin-bottom: 0.5rem;
        user-select: none;
    }
    .footer .footer-right .footer-columns a {
        display: block;
        color: var(--text-1);
        font-size: 0.9rem;
        text-decoration: none;
        white-space: nowrap;
        margin: 0.25rem 0;
        transition: color 0.2s ease;
    }
    .footer .footer-right .footer-columns a:hover {
        color: var(--accent);
    }

    .link {
        color: var(--accent);
        font-weight: bold;
    }

    @media (max-width: 1100px) {
        .footer {
            padding: 1rem;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 1.5rem;
        }
        .footer-left {
            width: 100%;
            order: 2;
            margin-bottom: 0;
        }
        .footer-left .footer-info {
            justify-content: center;
            text-align: left;
        }
        .footer-left .footer-info .footer-logo {
            margin-right: 0.5rem;
        }
        .footer-left .footer-info .footer-text {
            font-size: 0.85rem;
            word-wrap: wrap;
            word-spacing: normal;
            word-break: normal;
        }
        .footer-right {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 1.5rem;
            order: 1;
            width: 100%;
        }
        .footer .footer-right .footer-columns {
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            justify-content: flex-start;
            gap: 1rem 2.5rem;
            width: 100%;
        }
        .footer-right .footer-columns h4 {
            font-size: 1rem;
        }
        .footer-right .footer-columns a {
            font-size: 0.9rem;
            padding: 0.25rem 0;
        }
    }
</style>
