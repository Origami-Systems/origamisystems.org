---
const props = Astro.props;
---

<a href={props.href}>
    <slot />
</a>
<style>
    /* Matches the-house-app.com blog links (UI 6 text-link). */
    a {
        color: var(--accent);
        font-weight: 700;
        text-decoration: none;
    }
    a:hover {
        text-decoration: underline;
    }
</style>
