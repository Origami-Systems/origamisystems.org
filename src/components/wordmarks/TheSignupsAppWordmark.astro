---
import { Image } from "astro:assets";
import signupsWordmarkDark from "@assets/icons/signups/dark/wordmark.png";
import signupsWordmarkLight from "@assets/icons/signups/light/wordmark.png";
---

<div class="logo thesignupsapp">
    <Image
        src={signupsWordmarkDark}
        alt="The Signups App Logo"
        class="icon icon-dark"
    />
    <Image
        src={signupsWordmarkLight}
        alt="The Signups App Logo"
        class="icon icon-light"
    />
</div>

<style>
    .logo {
        img {
            height: auto;
        }
        user-select: none;
    }

    .icon {
        max-width: 450px;
        width: 100%;
    }

    .icon-dark {
        display: none;
    }

    :global(html.dark) .icon-light {
        display: none;
    }

    :global(html.dark) .icon-dark {
        display: inline;
    }
</style>
