---
import { Image } from "astro:assets";
import { Card, AppSubmitButton } from "@origami-systems/ui";
import MainLayout from "~/layouts/MainLayout.astro";

import wordmarkDark from "@assets/icons/dark/wordmark.png";
import wordmarkLight from "@assets/icons/light/wordmark.png";

import houseWordmarkDark from "@assets/icons/house/dark/wordmark.png";
import houseWordmarkLight from "@assets/icons/house/light/wordmark.png";
---

<MainLayout>
    <div class="logo origamisystems">
        <Image
            src={wordmarkDark}
            alt="Origami Systems Logo"
            class="icon icon-dark"
        />
        <Image
            src={wordmarkLight}
            alt="Origami Systems Logo"
            class="icon icon-light"
        />
    </div>
    <h1>We are the creators of</h1>
    <div class="logo thehouseapp">
        <Image
            src={houseWordmarkDark}
            alt="The House App Logo"
            class="icon icon-dark"
        />
        <Image
            src={houseWordmarkLight}
            alt="The House App Logo"
            class="icon icon-light"
        />
    </div>
    <h1>and more to come!</h1>

    <Card>
        <h1>Get Started Today!</h1>
        <!-- TODO: link to services site -->
        <a href="/contact" class="link">
            <AppSubmitButton primary="true" client:only="vue"
                >Contact Us</AppSubmitButton
            >
        </a>
    </Card>
</MainLayout>
<style lang="scss">
    .thehouseapp {
        width: 100%;
        max-width: 300px;
    }

    .origamisystems {
        max-width: 450px;
    }

    .logo {
        img {
            height: auto;
        }
        user-select: none;
    }

    .icon {
        max-width: 400px;
    }

    .icon-dark {
        display: none;
    }

    :global(html.dark) .icon-light {
        display: none;
    }

    :global(html.dark) .icon-dark {
        display: inline;
    }

    @media (max-width: 460px) {
        .origamisystems {
            width: 100%;
            max-width: 100%;
        }
    }
</style>
