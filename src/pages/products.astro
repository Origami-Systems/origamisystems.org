---
import { Card, LargeTitleText, AppSubmitButton } from "@origami-systems/ui";
import MainLayout from "~/layouts/MainLayout.astro";

import TheHouseAppWordmark from "@/wordmarks/TheHouseAppWordmark.astro";
import TheGradesAppWordmark from "@/wordmarks/TheGradesAppWordmark.astro";
import TheSignupsAppWordmark from "@/wordmarks/TheSignupsAppWordmark.astro";
---

<MainLayout title="Products - Origami Systems">
    <LargeTitleText>Products</LargeTitleText>
    <div class="page">
        <Card>
            <a
                href="https://the-house-app.com"
                target="_blank"
                rel="noopener noreferrer"
                class="wordmark"
            >
                <TheHouseAppWordmark />
            </a>
            <section>
                <span class="heading">Key Features</span>
                <ul>
                    <li>
                        Customizable Houses: Create and manage house names,
                        colors, and the number of houses to fit your school’s
                        culture.
                    </li>
                    <li>
                        Instant Recognition: Administrators can quickly award
                        points to students, providing immediate feedback.
                    </li>
                    <li>
                        Announcements: Broadcast important messages to all users
                        for clear communication and transparency.
                    </li>
                    <li>
                        Calendar Management: Create calendars for students,
                        leaders, and administrators to stay organized.
                    </li>
                    <li>
                        Flexible for Any Organization: While built for schools,
                        the app can be tailored for other types of organizations
                        as needed.
                    </li>
                </ul>
            </section>

            <a
                href="https://the-house-app.com"
                target="_blank"
                rel="noopener noreferrer"
                class="link"
            >
                <AppSubmitButton theme="house" primary="true" client:only="vue">
                    See the website
                </AppSubmitButton>
            </a>
            <a
                href="https://app.the-house-app.com/example"
                target="_blank"
                rel="noopener noreferrer"
                class="link"
            >
                <AppSubmitButton theme="house" primary="true" client:only="vue">
                    Try it out
                </AppSubmitButton>
            </a>
        </Card>
        <Card>
            <a
                href="https://signups.origamisystems.org"
                target="_blank"
                rel="noopener noreferrer"
                class="wordmark"
            >
                <TheSignupsAppWordmark />
            </a>
            <section>
                <span class="heading">Key Features</span>
                <ul>
                    <li>
                        Customizable Signup Forms: Create forms for events,
                        volunteer opportunities, and activities with flexible
                        sections and slots.
                    </li>
                    <li>
                        Capacity Management: Set limits on individual slots and
                        automatically track available spots.
                    </li>
                    <li>
                        Waitlists: Allow participants to join a waitlist when a
                        slot is full.
                    </li>
                    <li>
                        Easy Sharing: Share signup forms with a public link so
                        participants can quickly find and join opportunities.
                    </li>
                    <li>
                        Organizer Dashboard: Monitor responses, view available
                        spots, manage participants, and track signup activity in
                        one place.
                    </li>
                    <li>
                        Flexible Scheduling: Assign dates, times, and locations
                        to signup opportunities to keep everyone organized.
                    </li>
                </ul>
            </section>

            <a
                href="https://signups.origamisystems.org"
                target="_blank"
                rel="noopener noreferrer"
                class="link"
            >
                <AppSubmitButton
                    theme="signups"
                    primary="true"
                    client:only="vue"
                >
                    Open The Signups App
                </AppSubmitButton>
            </a>
        </Card>
        <Card>
            <div class="wordmark">
                <TheGradesAppWordmark />
            </div>
            <section>
                <span class="heading">Coming soon!</span>
            </section>
        </Card>
    </div>
</MainLayout>
<style>
    .page {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .page > .card {
        width: 100%;
        max-width: 700px;

        .wordmark {
            margin-right: auto;
            max-width: 250px;
        }

        li {
            text-align: left;
        }

        .container {
            display: flex;
            flex-direction: column;
            gap: 20px;
            align-items: center;
            justify-content: center;
        }

        section {
            text-align: left;
            margin-top: 10px;
        }

        .heading {
            font-weight: bold;
            font-size: 1.2em;
        }
    }
</style>
