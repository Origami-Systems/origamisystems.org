---
import { Image } from "astro:assets";
import { AppSubmitButton, Badge, Card, CardGrid, LargeTitleText } from "@origami-systems/ui";
import {
    BookOpen,
    CalendarDays,
    ClipboardCheck,
    ClipboardList,
    Gauge,
    GraduationCap,
    HeartHandshake,
    Layers,
    Link2,
    ListChecks,
    ListOrdered,
    Megaphone,
    MonitorPlay,
    Palette,
    Trophy,
    UsersRound,
    Hourglass,
    Timer,
    Upload,
} from "@lucide/astro";
import MainLayout from "~/layouts/MainLayout.astro";
import TheHouseAppWordmark from "@/wordmarks/TheHouseAppWordmark.astro";
import TheGradesAppWordmark from "@/wordmarks/TheGradesAppWordmark.astro";
import TheSignupsAppWordmark from "@/wordmarks/TheSignupsAppWordmark.astro";
import TheShowsAppWordmark from "@/wordmarks/TheShowsAppWordmark.astro";
import accountLight from "@assets/icons/account/light/rounded.png";
import accountDark from "@assets/icons/account/dark/rounded.png";
---

<MainLayout
    title="Products - Origami Systems"
    description="The House App, The Signups App, The Shows App, and The Grades App: apps that each solve one problem well and share one Origami Systems account."
    mainClass="marketing products"
>
    <section class="page-section header">
        <LargeTitleText>Products</LargeTitleText>
        <p class="lede">
            Each app solves one problem well. Use one on its own or several
            together with the same account.
        </p>
    </section>

    <div class="product-list">
        <article class="product" style="--accent: var(--house-app)">
            <header class="product-header">
                <div class="wordmark"><TheHouseAppWordmark /></div>
                <p>
                    Build community through friendly competition. Bring houses,
                    points, events, and announcements together in one shared
                    home.
                </p>
                <div class="actions">
                    <a
                        href="https://the-house-app.com"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <AppSubmitButton theme="house" client:only="vue">
                            Visit the Website
                        </AppSubmitButton>
                    </a>
                    <a
                        href="https://app.the-house-app.com/example"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <AppSubmitButton client:only="vue">
                            Explore an Example
                        </AppSubmitButton>
                    </a>
                </div>
            </header>
            <ul class="features" aria-label="The House App features">
                <li>
                    <Palette size={20} aria-hidden="true" />
                    <span><strong>Your houses</strong> Names, colors, mottos, leaders, and as many houses as you need.</span>
                </li>
                <li>
                    <Trophy size={20} aria-hidden="true" />
                    <span><strong>Points and standings</strong> Award points as they are earned and show live results.</span>
                </li>
                <li>
                    <Megaphone size={20} aria-hidden="true" />
                    <span><strong>Announcements</strong> Send updates to everyone or just the people who need them.</span>
                </li>
                <li>
                    <CalendarDays size={20} aria-hidden="true" />
                    <span><strong>Calendars</strong> Separate calendars for students, leaders, and staff.</span>
                </li>
            </ul>
        </article>

        <article class="product" style="--accent: var(--signups-app)">
            <header class="product-header">
                <div class="wordmark"><TheSignupsAppWordmark /></div>
                <p>
                    Collect signups for events, shifts, and volunteer work
                    without the spreadsheet. Set it up in minutes and share one
                    link.
                </p>
                <div class="actions">
                    <a
                        href="https://signups.origamisystems.org"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <AppSubmitButton theme="signups" client:only="vue">
                            Open The Signups App
                        </AppSubmitButton>
                    </a>
                    <a href="/signups">
                        <AppSubmitButton client:only="vue">Learn More</AppSubmitButton>
                    </a>
                </div>
            </header>
            <ul class="features" aria-label="The Signups App features">
                <li>
                    <ClipboardList size={20} aria-hidden="true" />
                    <span><strong>Flexible forms</strong> Organize sections and slots with dates, times, and locations.</span>
                </li>
                <li>
                    <Gauge size={20} aria-hidden="true" />
                    <span><strong>Capacity limits</strong> Cap each slot and see open spots update on their own.</span>
                </li>
                <li>
                    <Hourglass size={20} aria-hidden="true" />
                    <span><strong>Waitlists</strong> Let people wait for a spot when a slot fills up.</span>
                </li>
                <li>
                    <Link2 size={20} aria-hidden="true" />
                    <span><strong>Easy sharing</strong> Share a public link so anyone can find and join.</span>
                </li>
                <li>
                    <UsersRound size={20} aria-hidden="true" />
                    <span><strong>Organizer dashboard</strong> Follow responses and manage participants in one place.</span>
                </li>
            </ul>
        </article>

        <article
            class="product"
            style="--accent: var(--shows-app)"
        >
            <header class="product-header">
                <div class="title-row">
                    <div class="wordmark"><TheShowsAppWordmark /></div>
                    <Badge>Coming soon</Badge>
                </div>
                <p>
                    Plan your run of show, run it live, and keep every screen
                    in sync. When the schedule changes, everyone sees it.
                </p>
            </header>
            <ul class="features" aria-label="The Shows App plans">
                <li>
                    <ListOrdered size={20} aria-hidden="true" />
                    <span><strong>Run of show</strong> Give each segment a duration and the start times work themselves out. Lock fixed times like lunch.</span>
                </li>
                <li>
                    <Timer size={20} aria-hidden="true" />
                    <span><strong>Live timer</strong> Start, pause, and advance cues, and see how far ahead or behind the show is.</span>
                </li>
                <li>
                    <MonitorPlay size={20} aria-hidden="true" />
                    <span><strong>Stage displays</strong> Countdown clocks and booth messages on any monitor, tablet, or phone, from one link.</span>
                </li>
                <li>
                    <Upload size={20} aria-hidden="true" />
                    <span><strong>Speaker uploads</strong> Speakers send slides, videos, and bios from a private link, with no account needed.</span>
                </li>
                <li>
                    <UsersRound size={20} aria-hidden="true" />
                    <span><strong>Views for each crew</strong> Audio, lighting, video, and stage crews each see only the columns they need.</span>
                </li>
            </ul>
        </article>

        <article class="product" style="--accent: var(--grades-app)">
            <header class="product-header">
                <div class="title-row">
                    <div class="wordmark"><TheGradesAppWordmark /></div>
                    <Badge theme="grades">Coming soon</Badge>
                </div>
                <p>
                    A straightforward gradebook for teachers, with the
                    attendance and records a school needs, all working with the
                    rest of our apps.
                </p>
            </header>
            <ul class="features" aria-label="The Grades App plans">
                <li>
                    <ListChecks size={20} aria-hidden="true" />
                    <span><strong>Gradebooks</strong> Enter scores and feedback, then publish grades when students should see them.</span>
                </li>
                <li>
                    <ClipboardCheck size={20} aria-hidden="true" />
                    <span><strong>Attendance</strong> Mark each student present, absent, late, or excused, with a note when needed.</span>
                </li>
                <li>
                    <Layers size={20} aria-hidden="true" />
                    <span><strong>Course modules</strong> Group assignments into modules, set prerequisites, and let modules complete on their own.</span>
                </li>
                <li>
                    <GraduationCap size={20} aria-hidden="true" />
                    <span><strong>Transcripts and diploma plans</strong> Track credits toward graduation and keep final records for every year.</span>
                </li>
                <li>
                    <HeartHandshake size={20} aria-hidden="true" />
                    <span><strong>Family access</strong> Guardians see their student's published grades and attendance.</span>
                </li>
            </ul>
        </article>
    </div>

    <section class="page-section">
        <div class="section-intro">
            <h2>Included with every app.</h2>
            <p>These come with each product at no extra setup.</p>
        </div>
        <CardGrid class="card-grid-wide" minWidth="300px">
            <Card heading="h3">
                <span slot="title" class="card-title-row account-head"><Image src={accountLight} alt="" class="app-icon icon-light" />
                    <Image src={accountDark} alt="" class="app-icon icon-dark" />Origami Systems Account</span>
                <p>
                    One sign-in for every app, with passkeys, two-factor
                    authentication, and sessions that stay signed in.
                </p>
                <a href="https://account.origamisystems.org" class="card-action" target="_blank" rel="noopener noreferrer"><AppSubmitButton client:only="vue">Open your account</AppSubmitButton></a>
            </Card>
            <Card heading="h3">
                <span slot="title" class="card-title-row"><span class="feature-icon"><BookOpen size={22} aria-hidden="true" /></span>The Help App</span>
                <p>
                    Guides for every product, plus a direct way to contact us
                    when something goes wrong.
                </p>
                <a href="https://help.origamisystems.org" class="card-action" target="_blank" rel="noopener noreferrer"><AppSubmitButton client:only="vue">Visit The Help App</AppSubmitButton></a>
            </Card>
        </CardGrid>
    </section>

    <section class="cta">
        <div class="cta-copy">
            <h2>Not sure where to start?</h2>
            <p>
                Tell us what you are organizing and we will point you to the
                right app.
            </p>
        </div>
        <div class="actions">
            <a href="/contact">
                <AppSubmitButton primary client:only="vue">Contact Us</AppSubmitButton>
            </a>
            <a href="/schools">
                <AppSubmitButton client:only="vue">For Schools</AppSubmitButton>
            </a>
        </div>
    </section>
</MainLayout>

<style>
    .header {
        gap: var(--space-control);
    }
    .product-list {
        display: flex;
        flex-direction: column;
        gap: var(--space-section);
        width: min(1000px, 100%);
        margin-top: -3rem;
    }
    .product {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        border: var(--border);
        border-radius: var(--border-radius);
        background: var(--card-background);
        overflow: hidden;
    }
    .product-header {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-section);
        padding: clamp(20px, 4vw, 40px);
        border-right: var(--border);
    }
    .title-row .wordmark {
        flex: 0 1 240px;
    }
    .title-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-control);
    }
    .wordmark {
        width: min(240px, 100%);
    }
    .product-header p {
        margin: 0;
        color: var(--text-1);
        font-size: 1.05rem;
        line-height: 1.6;
    }
    .features {
        list-style: none;
        margin: 0;
        padding: clamp(20px, 4vw, 40px);
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 1.1rem;
    }
    .features li {
        display: flex;
        gap: 0.8rem;
        align-items: flex-start;
        line-height: var(--line-height-body);
    }
    .features li > :global(svg) {
        flex-shrink: 0;
        margin-top: 2px;
        color: var(--accent);
    }
    .features span {
        color: var(--subtext-0);
    }
    .features strong {
        display: block;
        color: var(--text-0);
        font-weight: var(--weight-label);
    }
    .account-head {
        display: flex;
        align-items: center;
        gap: var(--space-control);
    }
    .account-head :global(.app-icon) {
        width: 44px;
        height: 44px;
    }
    .account-head :global(.icon-dark) {
        display: none;
    }
    :global(html.dark) .account-head :global(.icon-light) {
        display: none;
    }
    :global(html.dark) .account-head :global(.icon-dark) {
        display: block;
    }
    @media (max-width: 800px) {
        .product {
            grid-template-columns: 1fr;
        }
        .product-header {
            border-right: none;
            border-bottom: var(--border);
        }
    }
</style>
