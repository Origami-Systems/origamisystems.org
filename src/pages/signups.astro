---
import { AppSubmitButton, Card } from "@origami-systems/ui";
import {
    CalendarClock,
    ClipboardList,
    Gauge,
    Hourglass,
    Link2,
    UsersRound,
} from "@lucide/astro";
import MainLayout from "~/layouts/MainLayout.astro";
import TheSignupsAppWordmark from "@/wordmarks/TheSignupsAppWordmark.astro";
import SignupPreview from "~/components/signups/SignupPreview.astro";

const features = [
    {
        title: "Sections and slots",
        icon: ClipboardList,
        text: "Group slots into sections so a big event stays easy to read, from setup to cleanup.",
    },
    {
        title: "Dates, times, and places",
        icon: CalendarClock,
        text: "Give each slot its own schedule and location so people know exactly where to be.",
    },
    {
        title: "Capacity limits",
        icon: Gauge,
        text: "Cap each slot and watch the open spots update as people sign up.",
    },
    {
        title: "Waitlists",
        icon: Hourglass,
        text: "When a slot fills up, people can join the waitlist instead of being turned away.",
    },
    {
        title: "One link to share",
        icon: Link2,
        text: "Send a public link and anyone can find the form and pick a slot.",
    },
    {
        title: "Organizer dashboard",
        icon: UsersRound,
        text: "Follow responses, see who signed up for what, and manage participants in one place.",
    },
];
---

<MainLayout
    title="The Signups App - Origami Systems"
    description="Collect signups for events, shifts, and volunteer work with slots, capacity limits, and waitlists."
    mainClass="marketing signups-page"
>
    <section class="hero">
        <div class="hero-copy">
            <div class="wordmark">
                <TheSignupsAppWordmark />
            </div>
            <h1>Signups without the spreadsheet.</h1>
            <p class="hero-tagline">
                Set up a form in minutes, share one link, and let the slots fill
                themselves.
            </p>
            <div class="actions">
                <a
                    href="https://signups.origamisystems.org"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <AppSubmitButton theme="signups" primary client:only="vue">
                        Open The Signups App
                    </AppSubmitButton>
                </a>
                <a href="/contact">
                    <AppSubmitButton client:only="vue">
                        Talk to Us
                    </AppSubmitButton>
                </a>
            </div>
        </div>

        <SignupPreview />
    </section>

    <section class="page-section">
        <div class="section-intro centered">
            <h2>Everyone knows where they're needed.</h2>
            <p>
                Volunteer shifts, parent conferences, potlucks, and practice
                schedules all come down to the same thing: who is doing what,
                and when. The Signups App keeps that in one clear place for
                organizers and participants.
            </p>
        </div>
    </section>

    <section class="feature-grid" aria-label="Features">
        {features.map((feature, index) => (
            <Card
                class:list={[
                    "feature",
                    { wide: index === 0 || index === features.length - 1 },
                ]}
            >
                <span class="feature-icon">
                    <feature.icon size={24} aria-hidden="true" />
                </span>
                <h3>{feature.title}</h3>
                <p>{feature.text}</p>
                {index === 0 && (
                    <div
                        class="feature-example"
                        aria-label="Example signup slots"
                    >
                        <span>
                            Setup crew <strong>4 of 6 filled</strong>
                        </span>
                        <span>
                            Ticket booth <strong>4 of 4 filled</strong>
                        </span>
                        <span>
                            Cleanup <strong>2 of 5 filled</strong>
                        </span>
                    </div>
                )}
                {index === features.length - 1 && (
                    <div class="feature-example">
                        <span>
                            Fall Festival Volunteers{" "}
                            <strong>10 participants</strong>
                        </span>
                    </div>
                )}
            </Card>
        ))}
    </section>

    <section class="getting-started">
        <div class="steps-title">
            <h2>Ready in three steps.</h2>
        </div>
        <p class="steps-description">
            Create a signup, add the details, and share it with your community.
        </p>
        <ol class="steps">
            <li>
                <strong>Create a form</strong>
                <p>Name your event and add the details people need.</p>
            </li>
            <li>
                <strong>Add your slots</strong>
                <p>Set times, places, and how many people each slot needs.</p>
            </li>
            <li>
                <strong>Share the link</strong>
                <p>Send it out and watch the spots fill up.</p>
            </li>
        </ol>
    </section>

    <section class="cta">
        <div class="cta-copy">
            <h2>Start your first signup.</h2>
            <p>
                Sign in with your Origami Systems account to create a form, or
                read the guides to see how it works.
            </p>
        </div>
        <div class="actions">
            <a
                href="https://signups.origamisystems.org"
                target="_blank"
                rel="noopener noreferrer"
            >
                <AppSubmitButton theme="signups" primary client:only="vue">
                    Open The Signups App
                </AppSubmitButton>
            </a>
            <a
                href="https://help.origamisystems.org/signups"
                target="_blank"
                rel="noopener noreferrer"
            >
                <AppSubmitButton client:only="vue">
                    Read the Guides
                </AppSubmitButton>
            </a>
        </div>
    </section>
</MainLayout>

<style>
    :global(main.signups-page) {
        --accent: var(--signups-app);
        gap: 7rem;
    }
    .hero {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(390px, 0.95fr);
        align-items: center;
        gap: clamp(3rem, 7vw, 7rem);
        min-height: 620px;
        width: 100%;
    }
    .hero-copy {
        padding-left: 20px;
    }
    .wordmark {
        width: min(250px, 70%);
        margin-bottom: 2.5rem;
    }
    h1 {
        margin: 0;
        font-size: clamp(3.4rem, 7vw, 6.2rem);
        letter-spacing: -5px;
        line-height: 0.92;
    }
    .hero-tagline {
        margin: 1.1rem 0 0;
        color: var(--text-1);
        font-size: clamp(1.2rem, 2vw, 1.5rem);
        font-weight: 700;
        line-height: 1.35;
    }
    .hero .actions {
        margin-top: 2rem;
    }
    .page-section .section-intro {
        max-width: 850px;
    }
    .page-section .section-intro h2,
    .getting-started h2 {
        margin: 0;
        font-size: clamp(2.2rem, 5vw, 4.2rem);
        line-height: 1.05;
        letter-spacing: -0.055em;
    }
    .page-section .section-intro p {
        max-width: 720px;
        margin: 1.4rem auto 0;
        line-height: 1.7;
    }
    .feature-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        width: min(1000px, 100%);
    }
    .feature {
        max-width: unset !important;
    }
    .feature.wide {
        grid-column: span 2;
    }
    .feature :global(.v-container) {
        display: grid;
        grid-template-areas: "icon" "title" "text";
    }
    .feature.wide :global(.v-container) {
        grid-template-columns: 1fr 1fr;
        grid-template-areas: "icon example" "title example" "text example";
        column-gap: 20px;
    }
    .feature-icon {
        grid-area: icon;
        width: 48px;
        height: 48px;
        margin-bottom: auto;
    }
    .feature h3 {
        grid-area: title;
        margin: 0;
    }
    .feature p {
        grid-area: text;
    }
    .feature-example {
        grid-area: example;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .feature-example span {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        border: 1px solid var(--background-1);
        border-radius: 13px;
        padding: 10px;
        font-size: 0.88rem;
    }
    .getting-started {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        width: min(1000px, 100%);
    }
    .steps-title {
        grid-column: span 2;
        align-self: center;
    }
    .steps-description {
        margin: 0;
        padding: 5px 10px;
        color: var(--subtext-0);
        line-height: 1.65;
    }
    .steps {
        grid-column: span 3;
        display: grid;
        grid-template-columns: subgrid;
        list-style: none;
        margin: 0;
        padding: 0;
        counter-reset: step;
    }
    .steps li {
        display: flex;
        flex-direction: column;
        border-top: 2px solid var(--background-1);
        padding: 1.4rem 0.4rem 0;
        counter-increment: step;
    }
    .steps li::before {
        content: "0" counter(step);
        color: var(--accent);
        font-size: 0.8rem;
        font-weight: 800;
        letter-spacing: 0.1em;
    }
    .steps strong {
        margin-top: 2rem;
        font-size: 1.18rem;
    }
    .steps p {
        margin: 0.5rem 0 0;
        color: var(--subtext-0);
        line-height: 1.5;
    }
    @media (max-width: 850px) {
        :global(main.signups-page) {
            gap: 5rem;
        }
        .hero {
            grid-template-columns: 1fr;
            min-height: auto;
        }
        .hero-copy {
            text-align: center;
            padding-left: 0;
        }
        .wordmark,
        .hero-tagline {
            margin-inline: auto;
        }
        .hero .actions {
            justify-content: center;
        }
        :global(.signups-page .signup-preview) {
            max-width: 520px;
            margin-inline: auto;
        }
        .feature-grid {
            grid-template-columns: 1fr;
        }
        .feature.wide {
            grid-column: auto;
        }
        .feature.wide :global(.v-container) {
            grid-template-columns: 1fr;
            grid-template-areas: "icon" "title" "text" "example";
        }
    }
    @media (max-width: 650px) {
        :global(main.signups-page) {
            gap: 4.5rem;
        }
        h1 {
            font-size: clamp(3.2rem, 16vw, 4.8rem);
        }
        .getting-started,
        .steps {
            grid-template-columns: 1fr;
        }
        .steps-title,
        .steps-description,
        .steps {
            grid-column: 1;
        }
        .steps li {
            margin-top: 1rem;
        }
    }
</style>
